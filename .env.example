# CredPilot environment.
#
# Copy to .env and fill in. .env is gitignored and must never be committed
# (REQ-085, secrets hygiene).

# --- Google Gemini: the only approved model provider (REQ-036) --------------
# Get a key from https://aistudio.google.com/apikey — it starts with "AIza".
# An OAuth access token (starting "AQ.") is NOT an API key and will 401.
#
# Not needed to build the indexes, run retrieval, run the retrieval evaluation
# or run the test suite: all of those are deterministic and call no model.
# Needed for the narrative rationale and the LLM-as-judge evaluation.
#
# Either spelling works — `src/llm.py` reads GOOGLE_API_KEY first and falls back
# to GEMINI_API_KEY, then exports GOOGLE_API_KEY for the SDK. Set one.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Arize Phoenix (REQ-040) ------------------------------------------------
# Tracing is off unless requested. Set to 1, or pass --trace, to emit spans.
CREDPILOT_TRACING=0
# Where the OTLP exporter sends spans. Start a local collector with
# `python -m phoenix.server.main serve` before enabling tracing.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=credpilot

# --- Supervisor routing -------------------------------------------------------
# The Supervisor classifies deterministically and only falls through to Gemini
# for genuinely ambiguous free text. That fallback is OFF by default, so routing
# behaves identically with and without a key, and the unit tests spend no tokens.
# Set to 1 to enable it.
CREDPILOT_SUPERVISOR_MODEL=0

# --- Narrative generation -------------------------------------------------------
# Set to 0/off to force the deterministic summary even when a key is present.
# Useful for a reproducible run with no model in it at all.
# CREDPILOT_NARRATIVE=1
# CREDPILOT_GEMINI_MODEL=gemini-flash-latest
# CREDPILOT_THINKING_LEVEL=low

# --- Optional path overrides -------------------------------------------------
# CREDPILOT_VECTORSTORE_PATH=data/vectorstore/credpilot
# CREDPILOT_LEXICAL_PATH=data/vectorstore/lexical
# CREDPILOT_LOG_DIR=logs

# --- Model overrides. Read config/rag.yaml before changing either. -----------
# These are the defaults, shown so the committed indexes are reproducible.
# Changing the embedding model means the committed Chroma collection no longer
# matches the query encoder, and retrieval degrades silently rather than
# failing — rebuild with `python scripts/build_policy_indexes.py` after any
# change here.
# CREDPILOT_EMBEDDING_MODEL=intfloat/e5-base-v2
# CREDPILOT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
