# CredPilot environment.
#
# Copy to .env and fill in. .env is gitignored and must never be committed
# (REQ-085, secrets hygiene).

# --- Google Gemini: the only approved model provider (REQ-036) --------------
# Get a key from https://aistudio.google.com/apikey — it starts with "AIza".
# An OAuth access token (starting "AQ.") is NOT an API key and will 401.
#
# Not needed to build the indexes, run retrieval, run the retrieval evaluation
# or run the test suite: all of those are deterministic and call no model.
# Needed for the narrative rationale and the LLM-as-judge evaluation.
GEMINI_API_KEY=

# --- Arize Phoenix (REQ-040) ------------------------------------------------
# Tracing is off unless requested. Set to 1, or pass --trace, to emit spans.
CREDPILOT_TRACING=0
# Where the OTLP exporter sends spans. Start a local collector with
# `python -m phoenix.server.main serve` before enabling tracing.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=credpilot

# --- Optional path overrides -------------------------------------------------
# CREDPILOT_VECTORSTORE_PATH=data/vectorstore/credpilot
# CREDPILOT_LEXICAL_PATH=data/vectorstore/lexical
# CREDPILOT_LOG_DIR=logs
# CREDPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CREDPILOT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
