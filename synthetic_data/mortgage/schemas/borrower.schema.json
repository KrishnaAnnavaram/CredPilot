{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credpilot/borrower.schema.json",
  "title": "CredPilot synthetic borrower profile",
  "type": "object",
  "required": [
    "borrower_id",
    "ssn_masked",
    "email"
  ],
  "properties": {
    "borrower_id": {
      "type": "string",
      "pattern": "^BORR-\\d{6}$"
    },
    "ssn_token": {
      "type": "string",
      "pattern": "^SYN-SSN-\\d{6}$"
    },
    "ssn_masked": {
      "type": "string",
      "pattern": "^\\*\\*\\*-\\*\\*-\\d{4}$"
    },
    "email": {
      "type": "string",
      "pattern": "@example\\.com$"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\(\\d{3}\\) 555-0\\d{3}$"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    }
  }
}
